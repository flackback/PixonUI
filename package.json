{
  "name": "pixonui-monorepo",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc -b",
    "check": "npm run lint && npm run typecheck",
    "test": "npm run test -w packages/ui",
    "test:ui": "pnpm -C packages/ui exec vitest run",
    "test:e2e": "playwright test",
    "test:motion:gate": "pnpm -C packages/ui exec vitest run && pnpm exec playwright test e2e/motion-presets.spec.ts e2e/timeline-scope-composer.spec.ts e2e/console-clean.spec.ts && pnpm exec playwright test e2e/motion-performance-budget.spec.ts --project=chromium --workers=1",
    "test:motion:production": "node scripts/motion-production-gate.mjs",
    "mcp:build": "npm run build -w @pixonui/mcp",
    "mcp:start": "npm run start -w @pixonui/mcp",
    "context:generate": "node scripts/generate-llm-context.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "typescript": "^5.3.3"
  },
  "version": "1.0.0"
}
