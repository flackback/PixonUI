{
  "name": "@pixonui/cli",
  "version": "0.1.0",
  "description": "CLI to initialize and copy PixonUI components directly in your project.",
  "main": "dist/index.js",
  "bin": {
    "pixonui": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --minify --shims",
    "dev": "tsup src/index.ts --format esm --watch",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "commander": "^11.1.0"
  },
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  }
}
